{
  "name": "form-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write src plugins tests index.ts app.config.ts metro.config.js package.json tsconfig.json README.md",
    "build:apk": "eas build --platform android --profile preview",
    "expo:login": "eas login",
    "check:upload": "node scripts/check-eas-upload.cjs",
    "prebuild:apk": "npm run check:upload"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@reactvision/react-viro": "3.0.3",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eas-cli": "^27.2.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
